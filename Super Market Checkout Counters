#include<stdio.h>
int main(){
   char*counters[]={"counter1","counter2","counter3"};
   int items[]={1,4,6},n=3,waiting[3]={0},turnaround[3];
   for(int i=1;i<n;i++){
      waiting[i]=waiting[i-1]+items[i-1];}
   printf("FCFS supermarket checkout \n  counter\tItems\twaiting\tturnaround \n");

   for(int i=0;i<n;i++){
       turnaround[i]=waiting[i]+items[i];
       printf("%-10s\t%d\t%d\t%d\n",counters[i],items[i],waiting[i],turnaround[i]);
   }
   return 0;
}
